{% set stepIndicator %}
  {% set steps = {
    '01': 'Company'|t,
    '02': 'Project'|t,
    '03': 'Client'|t,
    '04': 'Project details'|t,
    '05': 'Media'|t,
    '06': 'Completion'|t,
  } %}
  <div>
    {% for key, stepName in steps %}
      <div class="flex items-center my-3">
        <div class="flex items-center justify-center font-bold rounded-full w-[32px] h-[32px] me-5 {{ loop.index == step ? 'bg-saw-bright-blue text-white' : 'bg-saw-pale-blue' }}">{{ key }}</div>
        <div class="{{ loop.index == step ? 'font-bold'}}">{{ stepName }}</div>
      </div>
    {% endfor %}
  </div>
{% endset %}

{% include '@splash_awards/templates/includes/hero.twig' with {
  title: title,
} only %}

<div class="mb-3">
  {% include '@splash_awards/templates/includes/floater-skeleton.twig' with {
    title: 'Steps'|t,
    elements: [form],
    utils: stepIndicator,
  } only %}
</div>

