{% set cases %}
  {% for key, award in awardData %}
    <div class="flex mb-5 items-center gap-3">
      <h2 class="saw-large-headline text-saw-dark-blue">{{ award.name }}</h2>
      {% if award.active %}
        <p>{{ award.text }}</p>
      {% endif %}
    </div>
    {% for case in award.cases %}
      <div class="flex items-center">
        <img class="w-[80px] me-3" src="{{ case.imageSrc }}" alt="">
        <div>
          <h3 class="m-0 flex items-center gap-2">
            {{ case.title }}
            {% if case.submitted %}
              <span class="inline-flex items-center gap-1 saw-tiny-text font-bold text-saw-green" title="{{ 'Submitted'|t }}">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 8.5L6.5 12L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ 'Checked and Submitted'|t }}
              </span>
            {% endif %}
          </h3>
          {% if case.submitted and award.active %}
            <p class="saw-tiny-text text-saw-dark-blue/60 m-0 mb-1">{{ 'Still editable until the submission deadline.'|t }}</p>
          {% endif %}
          <span class="font-bold me-1">{{ 'Category'|t }}:</span>
          <span class="me-3">{{ case.category }}</span>
          <span class="font-bold me-1">{{ 'Status'|t }}:</span>
          <span class="me-3">{{ case.status }}</span>
          <span class="font-bold me-1">{{ 'Season'|t }}:</span>
          <span>{{ award.name }}</span>
        </div>
        {# Render the dropdown menu for active awards. #}
        {% if award.active %}
        <div x-data="{ open: false }" class="relative block ms-auto">
          <div class="flex bg-saw-bright-blue text-white hover:bg-saw-green py-2 px-2 rounded-lg transition-all">
            {# The main link. #}
            <a href="{{ case.editUrl }}"
               class="hover:no-underline">
              {{ 'Edit'|t }}
            </a>
            {# The dropdown button. #}
            <button @click="open=!open" class="flex items-center">
              <svg class="ms-2" width="12" height="8" viewBox="0 0 12 8"
                   fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11 1.5L6 6.5L1 1.5" stroke="white"
                      stroke-width="1.5" stroke-linecap="round"
                      stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {# The dropdown options. #}
          <div x-show="open" @click.away="open=false" class="absolute mt-1 left-0 w-48 rounded-lg bg-saw-pale-blue overflow-hidden z-10">
            {% for option in case.options %}
              <a href="{{ option.url }}"
                 class="block px-4 py-2 text-saw-dark-blue hover:bg-saw-green hover:no-underline">{{ option.text }}</a>
            {% endfor %}
          </div>
        </div>
        {% else %}
          {% if case.url %}
            {% include '@splash_awards/templates/includes/button.twig' with {
              buttonUrl: case.url,
              buttonText: 'Visit page'|t,
              buttonType: 'light',
              customClasses: 'ms-auto'
            } only %}
            {% else %}
              <small class="ms-auto text-saw-peach">
                  {{ 'unpublished'|t }}
              </small>
            {% endif %}
        {% endif %}
      </div>
      <div class="border border-saw-bright-blue border-b-0 my-5"></div>
    {% endfor %}
    {% if award.active %}
      {% include '@splash_awards/templates/includes/button.twig' with {
        buttonUrl: caseSubmissionUrl,
        buttonText: 'Submit case'|t,
        buttonType: 'cta',
        customClasses: 'inline-block mb-5'
      } only %}
    {% endif %}
  {% endfor %}
{% endset %}

{% set utils %}
  <div class="mt-3">
  {% if userData.logoUrl %}
    <img class="" src="{{ userData.logoUrl }}" alt="">
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'No logo uploaded'|t,
    } only %}
  {% endif %}

  {% if userData.name %}
    <h2 class="block saw-copy-text mt-5 mb-1 font-bold">{{ userData.name }}</h2>
  {% endif %}
  {% if userData.linkUrl %}
    <a class="block m-0" href="{{ userData.linkUrl }}" target="_blank">
      {{ userData.linkUrl }}
    </a>
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'No URL provided'|t,
    } only %}
  {% endif %}

  <span class="saw-copy-text block font-bold mt-5 mb-2">{{ 'Company size'|t }}</span>
  {% if userData.size %}
    <span class="saw-copy-text m-0">{{ userData.size }}</span>
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'Not provided'|t,
    } only %}
  {% endif %}

  <span class="saw-copy-text block font-bold mt-5 mb-2">{{ 'Contact person'|t }}</span>
  {% if userData.contactName %}
    <span class="block saw-copy-text mb-2">{{ userData.contactName }}</span>
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'No name provided'|t,
    } %}
  {% endif %}

  {% if userData.contactPhone %}
    <span class="block saw-copy-text mb-2">{{ userData.contactPhone }}</span>
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'No phone number provided'|t,
    } %}
  {% endif %}

  {% if userData.contactMail %}
    <a href="mailto:{{ userData.contactMail }}" class="block saw-copy-text m-0">{{ userData.contactMail }}</a>
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'No email provided'|t,
    } %}
  {% endif %}

  <span class="saw-copy-text block font-bold mt-5 mb-2">{{ 'Invoice information'|t }}</span>
  {% if userData.taxAddress %}
    <span class="block saw-copy-text mb-2 whitespace-pre">{{ userData.taxAddress }}</span>
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'No address provided'|t,
    } %}
  {% endif %}

  {% if userData.taxMail %}
    <a href="mailto:{{ userData.taxMail }}" class="block saw-copy-text m-0">{{ userData.taxMail }}</a>
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'No email provided'|t,
    } %}
  {% endif %}

  <span class="block saw-copy-text mt-5 mb-2">{{ 'Tax id number'|t }}</span>
  {% if userData.taxId %}
    <span class="block saw-copy-text m-0">{{ userData.taxId }}</span>
  {% else %}
    {% include '@splash_awards/templates/includes/error-text.twig' with {
      text: 'Not provided'|t,
    } %}
  {% endif %}

  {% include '@splash_awards/templates/includes/button.twig' with {
    buttonUrl: userEditUrl,
    buttonText: 'Edit account'|t,
    buttonType: 'light',
    customClasses: 'w-full text-center mt-5'
  } only %}
  {% include '@splash_awards/templates/includes/button.twig' with {
    buttonUrl: logoutUrl,
    buttonText: 'Logout'|t,
    buttonType: 'danger',
    customClasses: 'w-full text-center mt-3'
  } only %}
  </div>
{% endset %}

{% if hero %}
  {% include '@splash_awards/templates/includes/hero.twig' with {
    title: hero.title,
  } only %}
{% endif %}

{% include '@splash_awards/templates/includes/floater-skeleton.twig' with {
  title: 'Account'|t,
  elements: [cases],
  utils,
} only %}
