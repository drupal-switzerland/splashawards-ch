<footer class="bg-saw-dark-blue text-white flex items-center mt-auto">

  <div class="container px-2 max-w-[1200px] pt-[30px] pb-[20px] flex flex-col lg:flex-row">

    <div class="lg:w-1/2 flex flex-col justify-between">
      <div class="flex">
        <img class="w-[75px]" src="{{ base_path ~ directory }}/images/Splash-Awards-Mobile-White.svg" alt="Splash Awards Logo">
        <div class="ms-5  flex flex-col justify-center">
          <div class="font-bold text-[28px] tracking-wide">{{ siteName }}</div>
          {% if siteSlogan  %}
            <div class="font-light  text-[26px] tracking-tight">{{ siteSlogan }}</div>
          {% endif %}
        </div>
      </div>
      <div class="mt-5">
        {% if socialMenu %}
          <span class="block text-[14px]">{{ 'Find us on social media'|t }}</span>
          <div class="flex align-center mt-2">
            {% for item in socialMenu %}
              <a class="me-3 text-[14px] hover:opacity-80" href="{{ item.url }}"
                 target="{{ item.target }}">
                <img class="max-w-[294px]"
                     src="{{ item.icon }}"
                     alt="{{ item.alt }}"/>
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="flex flex-col justify-between mt-5 lg:mt-0">
      <nav class="hidden lg:block">
        {% for item in mainMenu %}
          <a class="me-3" href="{{ item.url }}"
             target="{{ item.target }}">{{ item.text }}</a>
        {% endfor %}
      </nav>

      <nav>
        {% for item in footerMenu %}
          <a class="me-3 text-[14px]" href="{{ item.url }}"
             target="{{ item.target }}">{{ item.text }}</a>
        {% endfor %}
        <span class="text-[14px]">© Splash Awards {{ 'now' | date('Y') }}</span>
      </nav>
    </div>
  </div>
</footer>

