<div id="skeleton-utils-sticky-container" class="z-10 self-start top-3 container max-w-[1200px] sm:grid sm:grid-cols-[300px_1fr] px-[20px] mb-3">
  <div class="relative">
    <div id="skeleton-utils" class="sm:absolute sm:inset-x-0 sm:pr-10">
      <div class="bg-white border border-saw-bright-blue mt-3 rounded-lg p-3">
        <div class="relative" x-data="{open:1}">
          <div type="button" class="flex items-center justify-between w-full cursor-pointer" @click="open !== 1 ? open = 1 : open = null">
            <h2>{{ title }}</h2>
            <svg :class="{'scale-y-[-1]': open === 1}" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 1.5L6 6.5L1 1.5" stroke="#120B47" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="relative overflow-hidden transition-all duration-700" x-ref="container1" x-bind:style="open == 1 ? 'max-height: ' + $refs.container1.scrollHeight + 'px' : 'max-height: 0px'">
            {{ utils }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% if elements is not empty %}
  <div id="skeleton-content" class="space-y-8">
    {% for element in elements %}
      <div class="{{ zebra and loop.index is even ? ' bg-saw-pale-blue' : 'bg-white' }}">
        <div class="container max-w-[1200px] px-[20px] sm:grid sm:grid-cols-[300px_1fr]">
          <div class="col-start-2 relative">
            {{ element }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}

{{ attach_library('splash_awards/skeleton-height-adjust') }}

