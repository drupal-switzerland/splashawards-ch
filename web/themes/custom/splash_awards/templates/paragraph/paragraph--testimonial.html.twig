{% set containerClasses = {
  'primary': 'bg-saw-bright-blue',
  'dark': 'bg-saw-dark-blue',
} %}

{% set svgFillMap = {
  'primary': '#120B47',
  'dark': '#0078FC',
} %}

<div class="{{ containerClasses[type] ~ ' flex items-center p-0 rounded-lg overflow-hidden' }}">
  {% if img %}
    <div class="py-1 relative">
      <img src="{{ img }}" class="absolute top-[13%] left-[-11%] rounded-full" alt="">
      <svg class="relative z-10" width="201" height="259" viewBox="0 0 201 259" fill="{{ svgFillMap[type] }}"
           xmlns="http://www.w3.org/2000/svg">
        <path d="M201 156.766L185.811 141.577C169.966 157.422 151.933 170.298 132.446 180.018C149.432 159.547 159.652 133.295 159.652 104.682H138.166C138.166 157.985 94.8021 201.348 41.5 201.348C-11.8021 201.348 -55.1657 157.985 -55.1657 104.682H-76.6522C-76.6522 133.295 -66.4325 159.547 -49.4464 180.018C-68.9327 170.298 -86.9657 157.422 -102.811 141.577L-118 156.766C-75.4021 199.364 -18.7559 222.835 41.5 222.835C101.74 222.835 158.386 199.379 201 156.766Z"/>
        <path d="M148.901 237.164H-65.9167V258.65H148.901V237.164Z"/>
        <path d="M41.5004 178.689C60.4554 178.689 79.4104 171.47 93.8493 157.047C122.712 128.184 122.712 81.2111 93.8493 52.3489L41.5004 0L-10.8485 52.3489C-39.7107 81.2111 -39.7107 128.184 -10.8485 157.047C3.57483 171.47 22.5454 178.689 41.5004 178.689ZM4.34051 67.5222L41.5004 30.3623L78.6603 67.5222C88.5832 77.4451 94.0524 90.6495 94.0524 104.682C94.0524 118.715 88.5832 131.919 78.6603 141.842C58.1739 162.328 24.8269 162.328 4.34051 141.842C-5.58234 131.919 -11.0516 118.715 -11.0516 104.682C-11.0516 90.6495 -5.58234 77.4451 4.34051 67.5222Z"/>
      </svg>
    </div>
  {% endif %}
  <div class="p-5 text-white">
    <p class="saw-small-headline">{{ text }}</p>
    <small>- {{ description }}</small>
  </div>
</div>
